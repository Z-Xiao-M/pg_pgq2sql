EXPLAIN (VERBOSE, COSTS OFF)
SELECT common_name
FROM LATERAL ( SELECT users_1.name AS common_name
        FROM users,
        follows,
        users users_1,
        follows follows_1,
        users users_2
        WHERE users.id = follows.follower AND users_1.id = follows.following AND users_2.id = follows_1.follower AND users_1.id = follows_1.following AND users.name::text = '张三'::text AND users_2.name::text = '李四'::text) "graph_table";
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Nested Loop
   Output: users_1.name
   Inner Unique: true
   ->  Hash Join
         Output: users_1.name, follows_1.follower
         Hash Cond: (follows_1.following = users_1.id)
         ->  Seq Scan on public.follows follows_1
               Output: follows_1.id, follows_1.follower, follows_1.following
         ->  Hash
               Output: follows.following, users_1.name, users_1.id
               ->  Nested Loop
                     Output: follows.following, users_1.name, users_1.id
                     Inner Unique: true
                     ->  Hash Join
                           Output: follows.following
                           Inner Unique: true
                           Hash Cond: (follows.follower = users.id)
                           ->  Seq Scan on public.follows
                                 Output: follows.id, follows.follower, follows.following
                           ->  Hash
                                 Output: users.id
                                 ->  Seq Scan on public.users
                                       Output: users.id
                                       Filter: ((users.name)::text = '张三'::text)
                     ->  Index Scan using users_pkey on public.users users_1
                           Output: users_1.id, users_1.name
                           Index Cond: (users_1.id = follows.following)
   ->  Index Scan using users_pkey on public.users users_2
         Output: users_2.id, users_2.name
         Index Cond: (users_2.id = follows_1.follower)
         Filter: ((users_2.name)::text = '李四'::text)
