-- ============================================================
-- Case 11: UNION ALL from multi-label edge (connections)
--   Alice's connections via follows: Bob, Charlie
--   Alice's connections via premium_follows: David
--   Total: Bob, Charlie, David
-- ============================================================
CREATE TEMP TABLE pgq_result AS
SELECT friend_name
FROM GRAPH_TABLE (
    sg_multi MATCH (a IS users)-[IS connections]->(b IS users)
    WHERE a.name = 'Alice'
    COLUMNS (b.name AS friend_name)
);
SELECT friend_name FROM pgq_result ORDER BY friend_name;
 friend_name 
-------------
 Bob
 Charlie
 David
(3 rows)

SELECT * FROM pg_pgq2sql($$
    SELECT friend_name
    FROM GRAPH_TABLE (
        sg_multi MATCH (a IS users)-[IS connections]->(b IS users)
        WHERE a.name = 'Alice'
        COLUMNS (b.name AS friend_name)
    )
$$);
                                                                     pg_pgq2sql                                                                     
----------------------------------------------------------------------------------------------------------------------------------------------------
  SELECT friend_name                                                                                                                               +
    FROM LATERAL ( SELECT users_1.name AS friend_name                                                                                              +
            FROM users,                                                                                                                            +
             follows,                                                                                                                              +
             users users_1                                                                                                                         +
           WHERE users.id = follows.follower AND users_1.id = follows.following AND users.name::text = 'Alice'::text                               +
         UNION ALL                                                                                                                                 +
          SELECT users_1.name AS friend_name                                                                                                       +
            FROM users,                                                                                                                            +
             premium_follows,                                                                                                                      +
             users users_1                                                                                                                         +
           WHERE users.id = premium_follows.follower AND users_1.id = premium_follows.following AND users.name::text = 'Alice'::text) "graph_table"
(1 row)

CREATE TEMP TABLE sql_result AS
SELECT friend_name
FROM LATERAL ( SELECT users_1.name AS friend_name
           FROM users, follows, users users_1
           WHERE users.id = follows.follower
             AND users_1.id = follows.following
             AND users.name::text = 'Alice'::text
         UNION ALL
          SELECT users_1.name AS friend_name
           FROM users, premium_follows, users users_1
           WHERE users.id = premium_follows.follower
             AND users_1.id = premium_follows.following
             AND users.name::text = 'Alice'::text) "graph_table";
SELECT friend_name FROM sql_result ORDER BY friend_name;
 friend_name 
-------------
 Bob
 Charlie
 David
(3 rows)

