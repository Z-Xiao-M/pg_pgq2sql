-- ============================================================
CREATE TEMP TABLE pgq_result AS
SELECT common_name
FROM GRAPH_TABLE (
    sg MATCH (a IS users)-[]->(x IS users)<-[]-(b IS users)
    WHERE a.name = 'Alice' AND b.name = 'Bob'
    COLUMNS (x.name AS common_name)
);
SELECT common_name FROM pgq_result;
 common_name 
